{"id": "setsuyaku_001_tofu_hamburg", "badge": "カサ増し", "title": "豆腐でカサ増しハンバーグ", "serving": "2人分・4個", "ingredients": [["合いびき肉", "150g"], ["木綿豆腐", "1/2丁（約150g）"], ["玉ねぎ", "1/4個"], ["パン粉", "大さじ3"], ["卵", "1個"], ["塩・こしょう", "少々"], ["サラダ油", "小さじ1"], ["ケチャップ・ソース", "各大さじ2"]], "steps": ["豆腐はキッチンペーパーで包み、電子レンジ（600W）で約2分加熱して水けをきる。玉ねぎはみじん切りにする。", "ボウルにひき肉・豆腐・玉ねぎ・パン粉・卵・塩・こしょうを入れ、よく混ぜて4等分し、平たい丸に形を整える。", "油を熱したフライパンで中火で焼き、焼き色がついたら裏返す。", "ふたをして弱火で約8分蒸し焼きにし、竹串を刺して透明な肉汁が出れば焼き上がり。", "ケチャップとソースをフライパンで軽く煮つめ、ハンバーグにかける。"], "tip": "豆腐の水けをしっかりきると、形がくずれにくくなります。", "tags": ["#カサ増しレシピ", "#豆腐ハンバーグ", "#節約レシピ", "#節約ごはん", "#おうちごはん"], "form": {"vessel": "plate", "parts": [{"t": "patty", "c": "#8a4a28", "c2": "#7a3e20", "n": 2, "s": 0.9}, {"t": "sheet", "c": "#9a2e1e", "s": 0.45, "h": 0.06, "y": 0.28}, {"t": "leaves", "c": "#5fa84a", "c2": "#8cc26a", "n": 8, "r": 0.85, "s": 0.9}, {"t": "balls", "c": "#e74c3c", "n": 2, "r": 0.85, "s": 0.8}]}},
{"id": "setsuyaku_002_moyashi_namul", "badge": "これしかない時", "title": "もやしだけナムル", "serving": "2人分", "ingredients": [["もやし", "1袋（約200g）"], ["ごま油", "大さじ1"], ["鶏ガラスープの素", "小さじ1/2"], ["にんにく（チューブ）", "約1cm"], ["塩", "少々"], ["白いりごま", "小さじ1"]], "steps": ["もやしを耐熱ボウルに入れてラップをし、電子レンジ（600W）で約3分加熱する。", "ざるにあげて粗熱をとり、水けをしっかりしぼる。", "ごま油・鶏ガラスープの素・にんにく・塩を加えてあえ、ごまをふる。"], "tip": "水けをしぼってから味をつけると、水っぽくなりません。", "tags": ["#もやしレシピ", "#ナムル", "#節約レシピ", "#これしかない時", "#レンジで簡単"], "form": {"vessel": "plate", "parts": [{"t": "sticks", "c": "#f6f2e2", "c2": "#ece4c8", "n": 80, "r": 0.55, "s": 0.8}, {"t": "specks", "c": "#f5efd8", "n": 40, "r": 0.5, "h": 0.3}, {"t": "specks", "c": "#c9a050", "n": 20, "r": 0.5, "h": 0.3}]}},
{"id": "setsuyaku_003_curry_udon", "badge": "リメイク", "title": "残ったカレーでカレーうどん", "serving": "1人分", "ingredients": [["残ったカレー", "お玉2杯分（約250g）"], ["ゆでうどん", "1玉"], ["水", "200ml"], ["めんつゆ（3倍濃縮）", "大さじ1"], ["片栗粉", "小さじ1（水小さじ2で溶く）"], ["長ねぎ", "5cm"]], "steps": ["冷蔵庫で保存したカレーを使う。鍋にカレー・水・めんつゆを入れ、混ぜながら中火でしっかり温め直す。", "ふつふつと煮立ったら、水溶き片栗粉を加えてとろみをつける。", "うどんを入れて約2分煮て、中まで温める。", "器に盛り、小口切りにしたねぎをのせる。"], "tip": "カレーが少ないときは、水とめんつゆを増やしてのばします。", "tags": ["#カレーうどん", "#カレーリメイク", "#リメイクレシピ", "#節約レシピ", "#残り物アレンジ"], "form": {"vessel": "bowl", "rim": "#3b2a20", "parts": [{"t": "liquid", "c": "#b8792a"}, {"t": "nest", "c": "#f4ecd6", "n": 16, "s": 0.75}, {"t": "sheet", "c": "#c08a35", "s": 0.5, "h": 0.05, "y": 0.2}, {"t": "specks", "c": "#5fa84a", "n": 40, "r": 0.4, "h": 0.32}]}},
{"id": "setsuyaku_004_moyashi_tsukune", "badge": "カサ増し", "title": "もやしでカサ増しつくね", "serving": "2人分・8個", "ingredients": [["鶏ひき肉", "150g"], ["もやし", "1/2袋（約100g）"], ["片栗粉", "大さじ2"], ["塩", "少々"], ["サラダ油", "小さじ2"], ["しょうゆ・みりん", "各大さじ1と1/2"], ["砂糖", "小さじ1"], ["白いりごま", "少々"]], "steps": ["もやしは粗く刻み、キッチンペーパーで水けをふく。", "ボウルにひき肉・もやし・片栗粉・塩を入れてよく混ぜ、8等分して平たい丸にする。", "油を熱したフライパンに並べ、中火で焼き色がつくまで焼いて裏返す。", "ふたをして弱火で約5分蒸し焼きにし、中まで火を通す。", "しょうゆ・みりん・砂糖を加えて煮からめ、ごまをふる。"], "tip": "もやしの水けをよくふくと、たねがまとまりやすくなります。", "tags": ["#つくね", "#カサ増しレシピ", "#もやしレシピ", "#節約レシピ", "#おうちごはん"], "form": {"vessel": "plate", "parts": [{"t": "patty", "c": "#9a5a26", "n": 3, "s": 0.6}, {"t": "sheet", "c": "#6e3510", "s": 0.95, "h": 0.05, "y": 0.02}, {"t": "specks", "c": "#f5f0e0", "n": 40, "r": 0.55, "h": 0.25}, {"t": "leaves", "c": "#5fa84a", "c2": "#3f7a2c", "n": 6, "r": 0.85}]}},
{"id": "setsuyaku_005_cabbage_okonomiyaki", "badge": "これしかない時", "title": "キャベツだけお好み焼き", "serving": "2枚分", "ingredients": [["キャベツ", "1/4個（約250g）"], ["小麦粉", "80g"], ["水", "100ml"], ["和風顆粒だし", "小さじ1/2"], ["サラダ油", "大さじ1"], ["ソース", "適量"], ["マヨネーズ", "適量"]], "steps": ["キャベツは粗めのみじん切りにする。", "ボウルに小麦粉・水・だしを入れて混ぜ、キャベツを加えてざっくり混ぜる。", "油を熱したフライパンに半量を丸く広げ、ふたをして中火で約4分焼く。", "裏返して再びふたをし、弱めの中火で約4分、中まで火を通す。", "器に盛り、ソースとマヨネーズをかける。残りも同様に焼く。"], "tip": "キャベツをたっぷり入れると、ふんわり軽い食感になります。", "tags": ["#お好み焼き", "#キャベツレシピ", "#これしかない時", "#節約レシピ", "#おうちごはん"], "form": {"vessel": "plate", "parts": [{"t": "cake", "c": "#d9a35a", "s": 1.25, "h": 0.14}, {"t": "sheet", "c": "#5a2a12", "s": 0.85, "h": 0.04, "y": 0.17}, {"t": "sticks", "c": "#f6f0d8", "n": 9, "r": 0.45, "y": 0.19, "s": 0.9}]}},
{"id": "setsuyaku_006_nabe_zosui", "badge": "リメイク", "title": "鍋の残り汁で雑炊", "serving": "2人分", "ingredients": [["鍋の残り汁", "約400ml"], ["ごはん", "茶碗1杯分（約150g）"], ["卵", "1個"], ["塩・しょうゆ", "少々"], ["長ねぎ", "5cm"]], "steps": ["冷蔵庫で保存した鍋の残り汁を使う。鍋に入れて中火にかけ、しっかり煮立たせて温め直す。", "ごはんを加えてほぐし、弱めの中火で約3分煮る。味をみて塩・しょうゆでととのえる。", "溶き卵を回し入れてふたをし、約1分煮て卵にしっかり火を通す。", "器に盛り、小口切りにしたねぎをのせる。"], "tip": "ごはんはさっと水で洗うと、さらっとした雑炊になります。", "tags": ["#雑炊", "#鍋の残り", "#リメイクレシピ", "#節約レシピ", "#シメ"], "form": {"vessel": "bowl", "rim": "#3b2a20", "parts": [{"t": "liquid", "c": "#efe0b5"}, {"t": "specks", "c": "#fbf7ee", "n": 160, "r": 0.7, "h": 0.03, "s": 1.6}, {"t": "leaves", "c": "#f3cf4a", "c2": "#f7dc7a", "n": 14, "r": 0.55, "s": 1.1}, {"t": "specks", "c": "#5fa84a", "n": 35, "r": 0.5, "h": 0.12}]}},
{"id": "setsuyaku_007_hanpen_nugget", "badge": "カサ増し", "title": "はんぺんでカサ増しチキンナゲット", "serving": "2人分・約12個", "ingredients": [["鶏ひき肉", "150g"], ["はんぺん", "1枚（約100g）"], ["片栗粉", "大さじ1"], ["マヨネーズ", "大さじ1"], ["塩・こしょう", "少々"], ["サラダ油", "大さじ3"], ["ケチャップ", "適量"]], "steps": ["ポリ袋にはんぺんを入れ、手でもんでなめらかにつぶす。", "ひき肉・片栗粉・マヨネーズ・塩・こしょうを加え、袋の上からよくもみ混ぜる。", "フライパンに油を熱し、たねをスプーンで小判形に落とす。", "中火で片面約3分ずつ揚げ焼きにし、中まで火を通す。油がはねやすいので注意する。", "油をきって器に盛り、ケチャップを添える。"], "tip": "クリスマスのパーティーにも。冷めてもふんわりやわらかです。", "tags": ["#チキンナゲット", "#はんぺんレシピ", "#カサ増しレシピ", "#クリスマス", "#節約レシピ"], "form": {"vessel": "plate", "parts": [{"t": "chunks", "c": "#d49a45", "c2": "#c98a38", "n": 9, "r": 0.5, "s": 1.6}, {"t": "sheet", "c": "#c0392b", "s": 0.25, "h": 0.15, "x": 0.6, "z": 0.35}, {"t": "leaves", "c": "#5fa84a", "c2": "#8cc26a", "n": 7, "r": 0.85}]}},
{"id": "setsuyaku_008_potato_tree", "badge": "これしかない時", "title": "じゃがいもだけツリーポテサラ", "serving": "2人分", "ingredients": [["じゃがいも", "2個（約300g）"], ["マヨネーズ", "大さじ2"], ["酢", "小さじ1"], ["塩・こしょう", "少々"], ["乾燥パセリ", "適量"], ["ケチャップ", "少々"]], "steps": ["じゃがいもは皮をむいて一口大に切り、水にさらす。", "耐熱ボウルに入れてラップをし、電子レンジ（600W）で約6分、竹串がすっと通るまで加熱する。", "熱いうちにつぶし、酢・塩・こしょうを混ぜて冷ます。", "マヨネーズを混ぜ、器に円すい形に盛る。", "パセリをふり、ケチャップを点々とのせて飾る。"], "tip": "ラップで包んで形を作ると、きれいなツリーになります。", "tags": ["#ポテトサラダ", "#クリスマス", "#じゃがいもレシピ", "#これしかない時", "#節約レシピ"], "form": {"vessel": "plate", "parts": [{"t": "cone", "c": "#f1e2a8", "s": 0.85}, {"t": "balls", "c": "#d63a2a", "n": 8, "r": 0.75, "s": 0.45}, {"t": "specks", "c": "#3f8f3a", "n": 90, "r": 0.8, "h": 0.03, "s": 1.4}]}},
{"id": "setsuyaku_009_chicken_tamagotoji", "badge": "リメイク", "title": "残ったチキンで卵とじ丼", "serving": "1人分", "ingredients": [["残ったチキン", "約100g"], ["卵", "2個"], ["玉ねぎ", "1/4個"], ["水", "80ml"], ["めんつゆ（3倍濃縮）", "大さじ1と1/2"], ["ごはん", "丼1杯分"], ["長ねぎ（青い部分）", "少々"]], "steps": ["冷蔵庫で保存したチキンを使う。骨があれば外し、一口大にほぐす。玉ねぎは薄切りにする。", "小さめのフライパンに水・めんつゆ・玉ねぎを入れ、玉ねぎがしんなりするまで煮る。", "チキンを加え、ふたをして約2分、中までしっかり温め直す。", "溶き卵を回し入れてふたをし、弱火で約1分、卵に火を通す。", "ごはんにのせ、小口切りにしたねぎを散らす。"], "tip": "フライドチキンでもローストチキンでも。衣がだしを吸っておいしくなります。", "tags": ["#クリスマスの残り", "#チキンリメイク", "#卵とじ丼", "#リメイクレシピ", "#節約レシピ"], "form": {"vessel": "donburi", "parts": [{"t": "mound", "c": "#fbf7ee", "s": 0.95, "h": 0.35}, {"t": "chunks", "c": "#a8662c", "c2": "#8f5422", "n": 8, "r": 0.45, "y": 0.2, "s": 1.3}, {"t": "sheet", "c": "#f2c94c", "s": 0.8, "h": 0.12, "y": 0.22}, {"t": "specks", "c": "#4f9a3a", "n": 40, "r": 0.5, "h": 0.35}]}},
{"id": "setsuyaku_010_hakusai_millefeuille", "badge": "カサ増し", "title": "白菜でカサ増し豚バラ重ね蒸し", "serving": "2人分", "ingredients": [["白菜", "1/8個（約300g）"], ["豚バラ薄切り肉", "100g"], ["水", "100ml"], ["和風顆粒だし", "小さじ1"], ["酒", "大さじ1"], ["塩", "少々"], ["ポン酢", "適量"]], "steps": ["白菜と豚肉を交互に重ね、5cm幅に切る。", "鍋の外側から切り口を上にしてすき間なく詰める。", "水・だし・酒・塩を加えてふたをし、中火にかける。", "煮立ったら弱火で約12分、豚肉の色が変わり白菜がやわらかくなるまで蒸し煮にする。", "ポン酢をつけて食べる。"], "tip": "年末で食費をおさえたいときに。白菜をたっぷり使うのがコツです。", "tags": ["#ミルフィーユ鍋", "#白菜レシピ", "#カサ増しレシピ", "#節約レシピ", "#鍋料理"], "form": {"vessel": "bowl", "rim": "#3b2a20", "parts": [{"t": "liquid", "c": "#e9dcb8"}, {"t": "slices", "c": "#f1f2d2", "c2": "#e2a08e", "n": 22, "r": 0.85, "ring": true, "s": 0.9}, {"t": "slices", "c": "#e9ecc2", "c2": "#dd9a88", "n": 10, "r": 0.4, "ring": true, "s": 0.7}, {"t": "leaves", "c": "#9cc86a", "n": 3, "r": 0.1}]}},
{"id": "setsuyaku_011_mochi_pizza", "badge": "リメイク", "title": "残ったおもちでもちピザ", "serving": "1枚分", "ingredients": [["残った切りもち", "2個"], ["ケチャップ", "大さじ1と1/2"], ["ピザ用チーズ", "30g"], ["ウインナー", "1本"], ["玉ねぎ", "1/8個"], ["サラダ油", "小さじ1"]], "steps": ["冷蔵庫で保存したおもちを使う。1個を4枚の薄切りにし、ウインナーは輪切り、玉ねぎは薄切りにする。", "油をひいたフライパンにおもちをすき間なく並べ、ふたをして弱火で約5分焼く。", "おもちがやわらかくなってくっついたら、ケチャップをぬってウインナー・玉ねぎ・チーズをのせる。", "ふたをして弱火で約4分、チーズが溶け、ウインナーまで温まるまで焼く。"], "tip": "熱いうちはおもちがよくのびるので、やけどに注意してください。", "tags": ["#もちピザ", "#おもちアレンジ", "#お正月", "#リメイクレシピ", "#節約レシピ"], "form": {"vessel": "plate", "parts": [{"t": "sheet", "c": "#f6efde", "s": 1.05, "h": 0.1}, {"t": "sheet", "c": "#c94a2a", "s": 0.95, "h": 0.11, "y": 0.01}, {"t": "sheet", "c": "#f6d77a", "s": 0.85, "h": 0.12, "y": 0.02}, {"t": "slices", "c": "#c8603a", "shape": "disc", "n": 7, "r": 0.55, "ring": true, "y": 0.08, "s": 0.6}, {"t": "specks", "c": "#4f9a3a", "n": 30, "r": 0.55, "h": 0.18}]}},
{"id": "setsuyaku_012_nishime_mazegohan", "badge": "リメイク", "title": "煮しめの残りで混ぜごはん", "serving": "2人分", "ingredients": [["残った煮しめ", "約150g"], ["煮しめの煮汁", "大さじ2"], ["温かいごはん", "茶碗2杯分（約300g）"], ["しょうゆ", "少々"], ["白いりごま", "小さじ1"]], "steps": ["冷蔵庫で保存した煮しめを使う。具を1cm角に切る。", "耐熱容器に具と煮汁を入れてラップをし、電子レンジ（600W）で約1分半、中までしっかり温め直す。", "温かいごはんに煮汁ごと加えてさっくり混ぜ、しょうゆで味をととのえる。", "器に盛り、ごまをふる。"], "tip": "にんじん・ごぼう・しいたけなど、おせちの残りが少しずつでも1品になります。", "tags": ["#おせちリメイク", "#煮しめ", "#混ぜごはん", "#リメイクレシピ", "#節約レシピ"], "form": {"vessel": "bowl", "rim": "#f1ece2", "parts": [{"t": "mound", "c": "#ead6a6", "s": 0.9, "h": 0.5}, {"t": "cubes", "c": "#e07a3a", "c2": "#7a4a28", "n": 16, "r": 0.45, "y": 0.25, "s": 0.9}, {"t": "sticks", "c": "#8a6040", "n": 8, "r": 0.4, "y": 0.3, "s": 0.5}, {"t": "specks", "c": "#f5f0e0", "n": 40, "r": 0.45, "h": 0.42}]}},
{"id": "setsuyaku_013_tamago_tenshin", "badge": "これしかない時", "title": "卵だけ天津あんかけ", "serving": "1人分", "ingredients": [["卵", "2個"], ["ごま油", "大さじ1/2"], ["塩", "少々"], ["水", "100ml"], ["鶏ガラスープの素", "小さじ1/2"], ["しょうゆ・砂糖・酢", "各小さじ1"], ["片栗粉", "小さじ1（水小さじ2で溶く）"]], "steps": ["卵に塩を入れて溶きほぐす。", "ごま油を熱したフライパンに卵を流し、大きく混ぜて丸く形を整え、両面をしっかり焼いて器に盛る。", "同じフライパンに水・スープの素・しょうゆ・砂糖・酢を入れて煮立てる。", "水溶き片栗粉でとろみをつけ、卵にかける。"], "tip": "ごはんにのせれば天津飯になります。", "tags": ["#天津飯", "#卵レシピ", "#これしかない時", "#節約レシピ", "#あんかけ"], "form": {"vessel": "plate", "parts": [{"t": "sheet", "c": "#b8662a", "s": 1.0, "h": 0.06}, {"t": "omelet", "c": "#f2c94c", "s": 0.85}, {"t": "sheet", "c": "#c97a35", "s": 0.55, "h": 0.1, "y": 0.4}]}},
{"id": "setsuyaku_014_cabbage_gyoza", "badge": "カサ増し", "title": "キャベツでカサ増し餃子", "serving": "2人分・20個", "ingredients": [["豚ひき肉", "100g"], ["キャベツ", "3枚（約150g）"], ["餃子の皮", "20枚"], ["しょうゆ・ごま油", "各小さじ1"], ["鶏ガラスープの素", "小さじ1/2"], ["塩", "少々"], ["サラダ油", "大さじ1"], ["水", "80ml"]], "steps": ["キャベツはみじん切りにして塩をふり、約5分おいて水けをしぼる。", "ひき肉・キャベツ・しょうゆ・ごま油・スープの素をよく混ぜ、皮で包む。", "油を熱したフライパンに並べ、中火で底に焼き色がつくまで焼く。", "水を入れてふたをし、約5分蒸し焼きにして中まで火を通す。", "ふたを取り、水分をとばしてカリッと焼き上げる。"], "tip": "キャベツの水けをよくしぼると、皮が破れにくくなります。", "tags": ["#餃子", "#キャベツレシピ", "#カサ増しレシピ", "#節約レシピ", "#おうちごはん"], "form": {"vessel": "plate", "parts": [{"t": "patty", "c": "#e8c088", "n": 4, "s": 0.62}, {"t": "specks", "c": "#a8622a", "n": 40, "r": 0.6, "h": 0.14}, {"t": "leaves", "c": "#5fa84a", "n": 4, "r": 0.88}]}},
{"id": "setsuyaku_015_daikon_steak", "badge": "これしかない時", "title": "大根だけステーキ", "serving": "2人分", "ingredients": [["大根", "8cm（約300g）"], ["サラダ油", "小さじ2"], ["バター", "10g"], ["しょうゆ・みりん", "各大さじ1"], ["水", "大さじ2"]], "steps": ["大根は皮をむいて2cm厚さの輪切りにし、両面に格子の切り込みを入れる。", "耐熱皿に並べてラップをし、電子レンジ（600W）で約6分、竹串が通るまで加熱する。", "油を熱したフライパンで、両面に焼き色がつくまで中火で焼く。", "バター・しょうゆ・みりん・水を加え、煮からめる。"], "tip": "レンジで先に火を通すと、焼く時間が短くなります。", "tags": ["#大根ステーキ", "#大根レシピ", "#これしかない時", "#節約レシピ", "#おうちごはん"], "form": {"vessel": "plate", "parts": [{"t": "slices", "c": "#d9a85a", "c2": "#cf9a4a", "shape": "disc", "n": 3, "r": 0.5, "ring": true, "s": 1.7}, {"t": "sheet", "c": "#7a4318", "s": 0.9, "h": 0.03}, {"t": "specks", "c": "#6e3510", "n": 30, "r": 0.45, "h": 0.08}]}},
{"id": "setsuyaku_016_cupmen_chawanmushi", "badge": "リメイク", "title": "カップラーメンの残り汁で茶碗蒸し", "serving": "2人分", "ingredients": [["カップラーメンの残り汁", "100ml"], ["卵", "1個"], ["水", "50ml"], ["長ねぎ（青い部分）", "少々"]], "steps": ["残り汁は食べてすぐ冷まし、冷蔵庫で保存したものをその日のうちに使う。茶こしでこし、水を加える。", "卵を溶きほぐし、汁を混ぜて耐熱の器2つに注ぐ。", "鍋に器の1/3ほどの高さまで湯を入れ、器を置く。ふたをして弱火で約12分蒸す。", "竹串を刺して透明な汁が出れば、中まで火が通っている。小口切りのねぎをのせる。"], "tip": "汁は塩分が強いので、水で割るのがおすすめです。", "tags": ["#茶碗蒸し", "#カップラーメン", "#リメイクレシピ", "#節約レシピ", "#卵レシピ"], "form": {"vessel": "cup", "parts": [{"t": "liquid", "c": "#f0cf7a"}, {"t": "specks", "c": "#4f9a3a", "n": 30, "r": 0.35, "h": 0.03, "s": 1.4}, {"t": "specks", "c": "#e8b85a", "n": 20, "r": 0.4, "h": 0.02}]}},
{"id": "setsuyaku_017_chikuwa_teriyaki", "badge": "これしかない時", "title": "ちくわだけ照り焼き", "serving": "2人分", "ingredients": [["ちくわ", "4本"], ["サラダ油", "小さじ1"], ["しょうゆ・みりん", "各大さじ1"], ["砂糖", "小さじ1"], ["白いりごま", "少々"]], "steps": ["ちくわは斜め半分に切る。", "油を熱したフライパンで、中火で表面に焼き色がつくまで転がしながら焼く。", "しょうゆ・みりん・砂糖を加え、とろみがつくまで煮からめる。", "器に盛り、ごまをふる。"], "tip": "お弁当のおかずにもぴったりです。", "tags": ["#ちくわレシピ", "#照り焼き", "#これしかない時", "#節約レシピ", "#お弁当おかず"], "form": {"vessel": "plate", "parts": [{"t": "log", "c": "#b8682a", "c2": "#f3e3c0", "s": 0.6}, {"t": "slices", "c": "#c07a35", "c2": "#b06a2a", "shape": "disc", "n": 6, "r": 0.85, "ring": true, "s": 0.9}, {"t": "specks", "c": "#f5f0e0", "n": 40, "r": 0.5, "h": 0.5}]}},
{"id": "setsuyaku_018_okara_soboro", "badge": "カサ増し", "title": "おからでカサ増しそぼろ丼", "serving": "2人分", "ingredients": [["鶏ひき肉", "100g"], ["おから", "50g"], ["しょうゆ・砂糖", "各大さじ1と1/2"], ["酒", "大さじ1"], ["水", "大さじ3"], ["卵", "2個"], ["ごはん", "丼2杯分"]], "steps": ["フライパンにひき肉・おから・しょうゆ・砂糖・酒・水を入れて混ぜる。", "中火にかけ、菜箸4本でほぐしながら、肉の色が変わって汁けがなくなるまで炒る。", "別のフライパンに溶き卵を入れ、弱火で混ぜながら完全に火を通していり卵にする。", "ごはんにそぼろといり卵を半分ずつのせる。"], "tip": "おからが煮汁を吸って、しっとりしたそぼろになります。", "tags": ["#そぼろ丼", "#おからレシピ", "#カサ増しレシピ", "#節約レシピ", "#丼"], "form": {"vessel": "donburi", "parts": [{"t": "mound", "c": "#fbf7ee", "s": 0.95, "h": 0.32}, {"t": "sheet", "c": "#8a5a2e", "s": 0.56, "h": 0.18, "x": -0.3, "y": 0.2}, {"t": "sheet", "c": "#f2cc4a", "s": 0.56, "h": 0.18, "x": 0.3, "y": 0.2}, {"t": "specks", "c": "#6e4520", "n": 60, "r": 0.35, "h": 0.33}, {"t": "leaves", "c": "#4f9a3a", "n": 2, "r": 0.05, "y": 0.3}]}},
{"id": "setsuyaku_019_curry_doria", "badge": "リメイク", "title": "残ったカレーでカレードリア", "serving": "1人分", "ingredients": [["残ったカレー", "お玉1杯半分（約180g）"], ["ごはん", "茶碗1杯分（約150g）"], ["バター", "5g"], ["ピザ用チーズ", "40g"], ["乾燥パセリ", "少々"]], "steps": ["冷蔵庫で保存したカレーを使う。耐熱容器に入れてラップをし、電子レンジ（600W）で約2分、混ぜてさらに約1分、しっかり温め直す。", "グラタン皿にバターをぬってごはんを広げ、カレーをかける。", "チーズをのせ、トースターで約8分、チーズに焼き色がつくまで焼く。", "パセリをふる。"], "tip": "ゆで卵をのせると、ボリュームが出ます。", "tags": ["#カレードリア", "#カレーリメイク", "#リメイクレシピ", "#節約レシピ", "#残り物アレンジ"], "form": {"vessel": "gratin", "parts": [{"t": "liquid", "c": "#a8641e"}, {"t": "sheet", "c": "#f3c96a", "s": 0.72, "h": 0.12}, {"t": "specks", "c": "#b5651e", "n": 50, "r": 0.5, "h": 0.1, "s": 1.5}, {"t": "specks", "c": "#3f8f3a", "n": 30, "r": 0.45, "h": 0.12}]}},
{"id": "setsuyaku_020_tofu_steak", "badge": "これしかない時", "title": "豆腐だけステーキ", "serving": "2人分", "ingredients": [["木綿豆腐", "1丁（約300g）"], ["片栗粉", "大さじ2"], ["サラダ油", "大さじ1"], ["しょうゆ・みりん", "各大さじ1と1/2"], ["砂糖", "小さじ1"], ["にんにく（チューブ）", "約1cm"]], "steps": ["豆腐はキッチンペーパーで包み、重しをのせて約15分おいて水けをきる。", "横半分に切って厚みを半分にし、片栗粉を全体にまぶす。", "油を熱したフライパンで、中火で両面をこんがり焼く。", "しょうゆ・みりん・砂糖・にんにくを加え、煮からめる。"], "tip": "片栗粉をまぶすと、たれがよくからみます。", "tags": ["#豆腐ステーキ", "#豆腐レシピ", "#これしかない時", "#節約レシピ", "#おうちごはん"], "form": {"vessel": "plate", "parts": [{"t": "fillet", "c": "#d9a24a", "n": 2, "s": 1.0}, {"t": "sheet", "c": "#6e3510", "s": 0.95, "h": 0.04}, {"t": "leaves", "c": "#5fa84a", "c2": "#3f7a2c", "n": 6, "r": 0.88}]}},
{"id": "setsuyaku_021_konnyaku_sukini", "badge": "カサ増し", "title": "こんにゃくでカサ増し豚こますき煮", "serving": "2人分", "ingredients": [["豚こま切れ肉", "150g"], ["こんにゃく", "1枚（約250g）"], ["玉ねぎ", "1/2個"], ["しょうゆ", "大さじ2"], ["砂糖・みりん", "各大さじ1と1/2"], ["水", "100ml"], ["サラダ油", "小さじ1"]], "steps": ["こんにゃくは手で一口大にちぎり、下ゆでして水けをきる。玉ねぎはくし形に切る。", "油を熱した鍋で豚肉を炒め、色が変わったらこんにゃく・玉ねぎを加えて炒める。", "水・しょうゆ・砂糖・みりんを入れ、落としぶたをして中火で約10分煮る。", "豚肉に火が通り、煮汁が少なくなったら火を止める。"], "tip": "こんにゃくはちぎると味がしみやすくなります。", "tags": ["#すき煮", "#こんにゃくレシピ", "#カサ増しレシピ", "#節約レシピ", "#豚こま"], "form": {"vessel": "bowl", "rim": "#3b2a20", "parts": [{"t": "liquid", "c": "#7a4a20"}, {"t": "chunks", "c": "#7d7872", "c2": "#8f8a84", "n": 12, "r": 0.55, "s": 1.2}, {"t": "slices", "c": "#8b5a2b", "c2": "#a0683a", "n": 6, "s": 0.75, "y": 0.12}, {"t": "sticks", "c": "#e6c890", "n": 10, "r": 0.55, "y": 0.1}]}},
{"id": "setsuyaku_022_tamanegi_soup", "badge": "これしかない時", "title": "玉ねぎだけオニオンスープ", "serving": "2人分", "ingredients": [["玉ねぎ", "1個"], ["バター", "10g"], ["水", "400ml"], ["コンソメ（顆粒）", "小さじ2"], ["塩・こしょう", "少々"]], "steps": ["玉ねぎは縦半分に切って薄切りにする。", "耐熱ボウルに入れてラップをし、電子レンジ（600W）で約4分加熱する。", "鍋にバターを溶かし、玉ねぎを中火であめ色になるまで約8分炒める。", "水・コンソメを加えて約5分煮て、塩・こしょうで味をととのえる。"], "tip": "先にレンジで加熱すると、炒める時間が短くなります。", "tags": ["#オニオンスープ", "#玉ねぎレシピ", "#これしかない時", "#節約レシピ", "#スープ"], "form": {"vessel": "cup", "parts": [{"t": "liquid", "c": "#a8692a"}, {"t": "sticks", "c": "#d9a860", "c2": "#c99450", "n": 22, "r": 0.38, "s": 0.6}, {"t": "specks", "c": "#2b211c", "n": 25, "r": 0.4, "h": 0.06}]}},
{"id": "setsuyaku_023_karaage_amazu", "badge": "リメイク", "title": "残ったから揚げの甘酢あんかけ", "serving": "2人分", "ingredients": [["残ったから揚げ", "6〜8個"], ["玉ねぎ", "1/4個"], ["水", "100ml"], ["酢・砂糖・しょうゆ", "各大さじ1と1/2"], ["ケチャップ", "大さじ1"], ["片栗粉", "小さじ2（水大さじ1で溶く）"]], "steps": ["冷蔵庫で保存したから揚げを使う。耐熱皿にのせ、電子レンジ（600W）で約2分、中までしっかり温め直す。", "フライパンに薄切りの玉ねぎ・水・酢・砂糖・しょうゆ・ケチャップを入れ、玉ねぎがしんなりするまで煮る。", "水溶き片栗粉でとろみをつけ、から揚げを加えてからめる。"], "tip": "酢を入れたあとよく煮立てると、酸味がまろやかになります。", "tags": ["#から揚げリメイク", "#甘酢あんかけ", "#リメイクレシピ", "#節約レシピ", "#残り物アレンジ"], "form": {"vessel": "plate", "parts": [{"t": "sheet", "c": "#d9682a", "s": 0.95, "h": 0.06}, {"t": "chunks", "c": "#a8582a", "c2": "#b8652e", "n": 8, "r": 0.45, "s": 1.5}, {"t": "sheet", "c": "#e0782e", "s": 0.7, "h": 0.12, "y": 0.08}, {"t": "sticks", "c": "#f2e3b0", "n": 10, "r": 0.5, "y": 0.25}]}},
{"id": "setsuyaku_024_aburaage_nikuzume", "badge": "カサ増し", "title": "油揚げでカサ増し肉詰め焼き", "serving": "2人分", "ingredients": [["油揚げ", "2枚"], ["豚ひき肉", "120g"], ["長ねぎ", "1/3本"], ["しょうゆ", "小さじ1"], ["片栗粉", "小さじ1"], ["塩・こしょう", "少々"], ["ポン酢", "適量"]], "steps": ["油揚げは半分に切って袋状に開く。ねぎはみじん切りにする。", "ひき肉・ねぎ・しょうゆ・片栗粉・塩・こしょうをよく混ぜ、油揚げに等分に詰めて口を押さえる。", "油をひかずにフライパンに並べ、中火で焼き色がつくまで焼いて裏返す。", "ふたをして弱火で約6分焼き、中まで火を通す。食べやすく切り、ポン酢をかける。"], "tip": "油揚げから油が出るので、油はひかなくて大丈夫です。", "tags": ["#油揚げレシピ", "#肉詰め", "#カサ増しレシピ", "#節約レシピ", "#おつまみ"], "form": {"vessel": "plate", "parts": [{"t": "triangle", "c": "#d9a24a", "c2": "#c98f38", "n": 3, "s": 0.8, "h": 0.3}, {"t": "specks", "c": "#5fa84a", "n": 40, "r": 0.5, "h": 0.4}, {"t": "leaves", "c": "#5fa84a", "c2": "#8cc26a", "n": 6, "r": 0.85}]}},
{"id": "setsuyaku_025_hakusai_umani", "badge": "これしかない時", "title": "白菜だけとろとろうま煮", "serving": "2人分", "ingredients": [["白菜", "1/8個（約300g）"], ["水", "200ml"], ["鶏ガラスープの素", "小さじ2"], ["しょうゆ", "小さじ1"], ["ごま油", "大さじ1/2"], ["片栗粉", "大さじ1（水大さじ2で溶く）"]], "steps": ["白菜は芯をそぎ切り、葉はざく切りにする。", "ごま油を熱したフライパンで芯を炒め、しんなりしたら葉を加える。", "水・スープの素・しょうゆを入れ、ふたをして中火で約5分煮る。", "火を弱め、水溶き片栗粉でとろみをつける。"], "tip": "ごはんにかけて、中華丼風にしてもおいしいです。", "tags": ["#白菜レシピ", "#うま煮", "#これしかない時", "#節約レシピ", "#あんかけ"], "form": {"vessel": "plate", "parts": [{"t": "sheet", "c": "#e8dfb8", "s": 1.0, "h": 0.06}, {"t": "leaves", "c": "#f1f2d8", "c2": "#c9e08a", "n": 26, "r": 0.55, "s": 1.5}, {"t": "sheet", "c": "#eee6c4", "s": 0.7, "h": 0.1, "y": 0.08}, {"t": "leaves", "c": "#a6cc6a", "n": 6, "r": 0.4, "y": 0.12, "s": 1.2}]}},
{"id": "setsuyaku_026_gohan_oyaki", "badge": "リメイク", "title": "残ったごはんでおやき", "serving": "2人分・6個", "ingredients": [["残ったごはん", "茶碗2杯分（約300g）"], ["片栗粉", "大さじ3"], ["粉チーズ", "大さじ1"], ["塩", "少々"], ["サラダ油", "小さじ2"], ["しょうゆ・みりん", "各大さじ1"]], "steps": ["冷蔵庫で保存したごはんを使う。耐熱容器に入れ、電子レンジ（600W）で約2分、しっかり温め直す。", "片栗粉・粉チーズ・塩を加えてよく混ぜ、6等分して平たい丸にする。", "油を熱したフライパンで、中火で両面をこんがり焼く。", "しょうゆ・みりんを加えて焼きからめる。"], "tip": "手に水をつけると、ごはんがくっつかずに形を作れます。", "tags": ["#おやき", "#残りごはん", "#リメイクレシピ", "#節約レシピ", "#おやつ"], "form": {"vessel": "plate", "parts": [{"t": "slices", "c": "#d29a4a", "c2": "#c08838", "shape": "disc", "n": 5, "r": 0.55, "ring": true, "s": 1.15}, {"t": "slices", "c": "#c8903e", "shape": "disc", "n": 1, "s": 1.15, "y": 0.02}, {"t": "specks", "c": "#fbf7ee", "n": 40, "r": 0.5, "h": 0.09}]}},
{"id": "setsuyaku_027_potato_chinjao", "badge": "カサ増し", "title": "じゃがいもでカサ増しチンジャオロース", "serving": "2人分", "ingredients": [["豚こま切れ肉", "100g"], ["じゃがいも", "1個（約150g）"], ["ピーマン", "2個"], ["片栗粉", "小さじ1"], ["ごま油", "大さじ1"], ["オイスターソース", "大さじ1"], ["しょうゆ・酒", "各小さじ2"]], "steps": ["じゃがいもは細切りにして水にさらし、水けをきる。ピーマンは細切り、豚肉は細く切って片栗粉をまぶす。", "ごま油を熱したフライパンで豚肉を炒め、色が変わったらじゃがいもを加えて約3分炒める。", "じゃがいもが透き通ったらピーマンを加えてさっと炒める。", "オイスターソース・しょうゆ・酒を加えて炒め合わせる。"], "tip": "じゃがいもは水にさらすと、シャキッと仕上がります。", "tags": ["#チンジャオロース", "#じゃがいもレシピ", "#カサ増しレシピ", "#節約レシピ", "#中華"], "form": {"vessel": "plate", "parts": [{"t": "sticks", "c": "#f0d890", "c2": "#3f8f3a", "n": 70, "r": 0.55, "s": 0.9}, {"t": "sticks", "c": "#7a4a24", "c2": "#4f9a3a", "n": 30, "r": 0.5, "s": 0.8, "y": 0.06}]}},
{"id": "setsuyaku_028_aburaage_karikari", "badge": "これしかない時", "title": "油揚げだけカリカリ焼き", "serving": "2人分", "ingredients": [["油揚げ", "2枚"], ["しょうゆ", "小さじ2"], ["七味唐辛子", "少々"]], "steps": ["油揚げはキッチンペーパーで表面の油をおさえる。", "油をひかないフライパンにのせ、弱めの中火で両面をカリッとするまで焼く。", "食べやすい大きさの三角に切って器に盛る。", "しょうゆをかけ、七味をふる。"], "tip": "トースターで約5分焼いても作れます。", "tags": ["#油揚げレシピ", "#カリカリ", "#これしかない時", "#節約レシピ", "#おつまみ"], "form": {"vessel": "plate", "parts": [{"t": "triangle", "c": "#c98a32", "c2": "#b87828", "n": 5, "s": 0.75, "h": 0.12}, {"t": "specks", "c": "#c0392b", "n": 30, "r": 0.45, "h": 0.5}]}},
{"id": "setsuyaku_029_nikujaga_croquette", "badge": "リメイク", "title": "残った肉じゃがでコロッケ", "serving": "2人分・4個", "ingredients": [["残った肉じゃが", "約300g"], ["小麦粉", "大さじ2"], ["溶き卵", "1個分"], ["パン粉", "適量"], ["サラダ油", "約1cm深さ"], ["ソース", "適量"], ["キャベツの千切り", "適量"]], "steps": ["冷蔵庫で保存した肉じゃがを使う。耐熱容器に入れ、電子レンジ（600W）で約3分、中までしっかり温め直す。", "汁けをきってつぶし、粗熱がとれたら4等分して小判形にする。", "小麦粉・溶き卵・パン粉の順に衣をつける。", "170℃の油で両面がきつね色になるまで約3分揚げ、中まで温める。油は高温なので注意する。", "キャベツと盛り、ソースをかける。"], "tip": "たねがやわらかいときは、パン粉を少し混ぜるとまとまります。", "tags": ["#コロッケ", "#肉じゃがリメイク", "#リメイクレシピ", "#節約レシピ", "#残り物アレンジ"], "form": {"vessel": "plate", "parts": [{"t": "patty", "c": "#c9873a", "n": 2, "s": 0.8}, {"t": "specks", "c": "#e0a850", "n": 70, "r": 0.55, "h": 0.27, "s": 1.5}, {"t": "leaves", "c": "#c8e098", "c2": "#8cc26a", "n": 10, "r": 0.88}, {"t": "sheet", "c": "#5a2a12", "s": 0.25, "h": 0.05, "y": 0.3}]}},
{"id": "setsuyaku_030_tuna_soboro", "badge": "これしかない時", "title": "ツナ缶だけツナそぼろ丼", "serving": "1人分", "ingredients": [["ツナ缶（油漬け）", "1缶（約70g）"], ["しょうゆ", "小さじ2"], ["砂糖", "小さじ1"], ["しょうが（チューブ）", "約1cm"], ["ごはん", "丼1杯分"]], "steps": ["フライパンにツナを缶汁ごと入れ、しょうゆ・砂糖・しょうがを加える。", "中火にかけ、ほぐしながら汁けがなくなるまで約3分炒る。", "ごはんにのせる。"], "tip": "多めに作って、おにぎりの具にしても便利です。", "tags": ["#ツナ缶レシピ", "#そぼろ丼", "#これしかない時", "#節約レシピ", "#ひとりごはん"], "form": {"vessel": "donburi", "parts": [{"t": "mound", "c": "#fbf7ee", "s": 0.95, "h": 0.32}, {"t": "sheet", "c": "#b88a52", "s": 0.65, "h": 0.15, "y": 0.2}, {"t": "specks", "c": "#8a6238", "n": 120, "r": 0.45, "h": 0.32, "s": 1.3}, {"t": "specks", "c": "#d6b07a", "n": 60, "r": 0.45, "h": 0.33, "s": 1.3}]}},
{"id": "setsuyaku_031_atsuage_hoikoro", "badge": "カサ増し", "title": "厚揚げでカサ増し回鍋肉", "serving": "2人分", "ingredients": [["豚こま切れ肉", "100g"], ["厚揚げ", "1枚（約150g）"], ["キャベツ", "3枚（約150g）"], ["味噌", "大さじ1"], ["砂糖・しょうゆ・酒", "各小さじ2"], ["豆板醤", "小さじ1/2"], ["ごま油", "大さじ1"]], "steps": ["厚揚げは一口大、キャベツはざく切りにする。味噌・砂糖・しょうゆ・酒・豆板醤を混ぜておく。", "ごま油を熱したフライパンで豚肉を炒め、色が変わったら厚揚げを加えて焼き色をつける。", "キャベツを加えて中火で約2分炒める。", "合わせた調味料を加え、全体にからめる。"], "tip": "辛いのが苦手なら、豆板醤なしでも作れます。", "tags": ["#回鍋肉", "#厚揚げレシピ", "#カサ増しレシピ", "#節約レシピ", "#中華"], "form": {"vessel": "plate", "parts": [{"t": "leaves", "c": "#8cc26a", "c2": "#c8e098", "n": 18, "r": 0.6, "s": 1.5}, {"t": "cubes", "c": "#c98a38", "c2": "#f3e6c4", "n": 10, "r": 0.5, "s": 1.4, "y": 0.05}, {"t": "chunks", "c": "#8a3e1e", "n": 8, "r": 0.5, "s": 1.0, "y": 0.08}, {"t": "sheet", "c": "#9a3a1e", "s": 0.75, "h": 0.04}]}},
{"id": "setsuyaku_032_kinpira_tamagoyaki", "badge": "リメイク", "title": "残ったきんぴらで卵焼き", "serving": "2人分", "ingredients": [["残ったきんぴらごぼう", "約50g"], ["卵", "3個"], ["砂糖", "小さじ1"], ["しょうゆ", "少々"], ["サラダ油", "小さじ1"]], "steps": ["冷蔵庫で保存したきんぴらを使う。電子レンジ（600W）で約30秒、しっかり温め直し、粗く刻む。", "卵を溶きほぐし、きんぴら・砂糖・しょうゆを混ぜる。", "油を熱した卵焼き器に1/3量ずつ流し入れ、巻きながら焼く。", "最後は弱火で転がし、中まで火を通す。食べやすく切る。"], "tip": "きんぴらの味がついているので、調味料は少なめで大丈夫です。", "tags": ["#卵焼き", "#きんぴらリメイク", "#リメイクレシピ", "#節約レシピ", "#お弁当おかず"], "form": {"vessel": "plate", "parts": [{"t": "fillet", "c": "#f2c94c", "n": 3, "s": 0.62}, {"t": "specks", "c": "#8a5a2e", "n": 30, "r": 0.45, "h": 0.16, "s": 1.6}, {"t": "specks", "c": "#e07a3a", "n": 15, "r": 0.45, "h": 0.16, "s": 1.6}, {"t": "leaves", "c": "#5fa84a", "c2": "#3f7a2c", "n": 6, "r": 0.88}]}},
{"id": "setsuyaku_033_yakionigiri", "badge": "これしかない時", "title": "ごはんだけ焼きおにぎり", "serving": "2個分", "ingredients": [["温かいごはん", "茶碗2杯分（約300g）"], ["しょうゆ", "大さじ1"], ["みりん", "小さじ1"], ["ごま油", "小さじ1"]], "steps": ["ごはんを2等分し、三角ににぎる。しょうゆとみりんを混ぜておく。", "ごま油を熱したフライパンで、弱めの中火で両面を約3分ずつ焼いて表面をかためる。", "たれを両面にぬり、焦がさないように香ばしく焼く。"], "tip": "表面をしっかり焼いてからたれをぬると、くずれにくくなります。", "tags": ["#焼きおにぎり", "#ごはんレシピ", "#これしかない時", "#節約レシピ", "#おにぎり"], "form": {"vessel": "plate", "parts": [{"t": "triangle", "c": "#b8742e", "c2": "#a8662a", "n": 2, "s": 0.85, "h": 0.35}, {"t": "specks", "c": "#d9a860", "n": 30, "r": 0.45, "h": 0.45}]}},
{"id": "setsuyaku_034_tofu_nikudango_soup", "badge": "カサ増し", "title": "豆腐でカサ増し肉だんごスープ", "serving": "2人分", "ingredients": [["鶏ひき肉", "100g"], ["絹ごし豆腐", "1/3丁（約100g）"], ["片栗粉", "大さじ1"], ["しょうが（チューブ）", "約1cm"], ["白菜", "1枚"], ["水", "500ml"], ["鶏ガラスープの素", "小さじ2"], ["塩・こしょう", "少々"]], "steps": ["ひき肉・豆腐・片栗粉・しょうが・塩をよく混ぜる。白菜はざく切りにする。", "鍋に水・スープの素を入れて煮立て、たねをスプーンで丸く落とし入れる。", "白菜を加え、中火で約6分、肉だんごが浮いて中まで火が通るまで煮る。", "塩・こしょうで味をととのえる。"], "tip": "豆腐を入れると、ふわふわのやわらかい肉だんごになります。", "tags": ["#肉だんごスープ", "#豆腐レシピ", "#カサ増しレシピ", "#節約レシピ", "#スープ"], "form": {"vessel": "bowl", "rim": "#f1ece2", "parts": [{"t": "liquid", "c": "#ecdcac"}, {"t": "balls", "c": "#c4a07a", "c2": "#b8926a", "n": 7, "r": 0.5, "s": 1.3}, {"t": "leaves", "c": "#b8d878", "c2": "#eef2d0", "n": 8, "r": 0.55, "s": 1.1}, {"t": "specks", "c": "#4f9a3a", "n": 30, "r": 0.5, "h": 0.12}]}}
